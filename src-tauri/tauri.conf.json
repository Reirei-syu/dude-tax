{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dude Tax",
  "version": "1.0.0",
  "identifier": "com.dud.tax",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dude Tax",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "个人所得税预估与年终奖优化本地工具",
    "longDescription": "Dude Tax — 累计预扣个税预估与年终奖计税方式对比。数据保存在用户配置目录，与开发环境数据库相互独立。",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
